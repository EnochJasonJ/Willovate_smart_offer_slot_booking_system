# --- BACKEND CONFIGURATION ---
# Note: In .NET, environment variables use double underscores '__' to represent hierarchy.
# These will override values in appsettings.json.

# Database Connection String
# Key: ConnectionStrings__DefaultConnection
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Database=smart_offer_booking;Username=postgres;Password=postgres

# JWT Authentication
# Key: Jwt__Key
JWT__KEY=YourVerySecureSecretKeyThatIsAtLeast32CharactersLong!
JWT__ISSUER=SmartOfferBooking
JWT__AUDIENCE=SmartOfferBooking
JWT__EXPIRYINMINUTES=60

# --- FRONTEND CONFIGURATION ---
# Base URL for the API
VITE_API_URL=http://localhost:5152/api
